{
  "name": "virtual-frog-lab",
  "version": "1.0.0",
  "description": "Virtual Frog Lab: frog heart and skeletal muscle experiments",
  "author": "Isha, MAMC MIC",
  "main": "main.js",
  "scripts": { "start": "electron ." },
  "build": {
    "appId": "in.mamc.virtualfroglab",
    "productName": "Virtual Frog Lab",
    "files": ["main.js", "index.html", "icon.png"],
    "win": { "target": "nsis", "icon": "icon.png", "artifactName": "Virtual_Frog_Lab_Setup_v${version}.${ext}" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "mac": { "identity": null, "icon": "icon.png", "target": [{ "target": "dmg", "arch": ["x64", "arm64"] }], "artifactName": "Virtual_Frog_Lab_v${version}_${arch}.${ext}" }
  },
  "devDependencies": { "electron": "^33.2.0", "electron-builder": "^25.1.8" }
}
